# =============================================================================
# roles/backend/templates/app.env.j2 — Variables de entorno para Spring Boot
# =============================================================================
#
# CONCEPTO:
#   Este archivo se carga por systemd via la directiva EnvironmentFile=
#   en el unit file del servicio.
#
#   Formato: CLAVE=valor (sin espacios alrededor del =, sin comillas)
#
# VENTAJA:
#   Separar las variables del unit file permite:
#   - Permisos restrictivos (0600 — solo root/propietario puede leer)
#   - Actualizar configuración sin tocar el unit file
#   - Cifrar este archivo con Ansible Vault para producción
#
# SPRING BOOT:
#   Spring Boot mapea automáticamente variables de entorno a properties.
#   Ejemplo: SPRING_DATASOURCE_URL → spring.datasource.url
#   Convención: punto (.) → underscore (_), todo en MAYÚSCULAS.
#
# ARCHIVO GENERADO:
#   {{ app_install_dir }}/{{ app_service_name }}.env
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Conexión a base de datos (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL={{ app_spring_datasource_url }}
SPRING_DATASOURCE_USERNAME={{ app_spring_datasource_username }}
SPRING_DATASOURCE_PASSWORD={{ app_spring_datasource_password }}

# ─────────────────────────────────────────────────────────────────────────────
# JPA / Hibernate
# ─────────────────────────────────────────────────────────────────────────────
# ddl-auto opciones: none, validate, update, create, create-drop
# "update" crea/modifica tablas automáticamente (solo para desarrollo)
SPRING_JPA_HIBERNATE_DDL_AUTO={{ app_spring_jpa_ddl_auto }}

# ─────────────────────────────────────────────────────────────────────────────
# Puerto del servidor (por si necesitas cambiarlo)
# ─────────────────────────────────────────────────────────────────────────────
SERVER_PORT={{ app_port }}
